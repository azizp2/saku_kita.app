# ==== Image tag (diisi CI, misal commit SHA atau versi rilis) ====
IMAGE_TAG=latest

# ==== Postgres ====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ganti_dengan_password_kuat
POSTGRES_DB=sakukita

# ==== JWT ====
JWT_ISSUER=SakuKita.Api
JWT_AUDIENCE=SakuKita.Mobile
# generate baru pakai: openssl rand -base64 64
JWT_SECRET_KEY=ganti_dengan_secret_baru_jangan_pakai_yang_lama
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30

# ==== CORS ==== (ganti sesuai domain frontend/mobile app production)
CORS_ORIGIN_0=https://app.sakukita.com
CORS_ORIGIN_1=https://admin.sakukita.com

# ==== RabbitMQ ====
RABBITMQ_USER=sakukita
RABBITMQ_PASSWORD=ganti_dengan_password_kuat

# ==== Gowa ====
GOWA_USER=admin
GOWA_PASSWORD=ganti_dengan_password_kuat
GOWA_DEVICE_ID=device-001
